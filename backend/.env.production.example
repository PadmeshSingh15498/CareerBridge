# ==============================================================================
# CareerBridge Production Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES (PASSWORDS, PRIVATE KEYS, API SECRETS) TO GIT.
# ==============================================================================

PROJECT_NAME="CareerBridge"
ENVIRONMENT="production"
DEBUG=False
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Security & Cryptography
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHAR_HEX_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_INVITE_TOKEN="REPLACE_WITH_STRONG_INSTITUTIONAL_INVITE_TOKEN"

# Cookie Security (Enforced: True for HTTPS in Production)
COOKIE_SECURE=True
COOKIE_SAMESITE="lax"

# ------------------------------------------------------------------------------
# Production Database (MySQL 8.0+ or AWS RDS / Cloud Managed)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
# ------------------------------------------------------------------------------
MYSQL_HOST="mysql.production.internal"
MYSQL_PORT=3306
MYSQL_USER="cb_app_user"
MYSQL_PASSWORD="REPLACE_WITH_STRONG_DB_PASSWORD"
MYSQL_DATABASE="careerbridge_prod"
DATABASE_URL="mysql+pymysql://cb_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@mysql.production.internal:3306/careerbridge_prod?charset=utf8mb4"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
# Optional SSL CA certificate path for AWS RDS / Google Cloud SQL:
# DATABASE_SSL_CA="/etc/ssl/certs/rds-combined-ca-bundle.pem"

# In production, fallback to temporary SQLite is strictly disabled
ENABLE_DB_FALLBACK=False

# ------------------------------------------------------------------------------
# CORS Production Whitelist (Comma-separated or JSON array)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["https://careerbridge.yourdomain.edu","https://app.careerbridge.io"]

# ------------------------------------------------------------------------------
# AI & LLM Provider Credentials
# ------------------------------------------------------------------------------
GEMINI_API_KEY="REPLACE_WITH_PRODUCTION_GEMINI_API_KEY"
AI_MOCK_FALLBACK=False

# ------------------------------------------------------------------------------
# File Storage (Persistent volume path)
# ------------------------------------------------------------------------------
STORAGE_DIR="/app/storage/resumes"

