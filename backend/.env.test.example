# ==============================================================================
# CareerBridge Automated Testing Environment Template
# ==============================================================================

PROJECT_NAME="CareerBridge (Test Runner)"
ENVIRONMENT="testing"
DEBUG=False
TESTING=1
LOG_LEVEL="WARNING"
API_V1_STR="/api/v1"

# Cryptography (Deterministic fast test secret)
SECRET_KEY="test_runner_secret_key_for_automated_ci_cd"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1
ADMIN_INVITE_TOKEN="test_admin_invite_token"

# Cookie Security
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# Database Configuration (Isolated test SQLite file)
DATABASE_URL="sqlite:///./careerbridge_test.db"
ENABLE_DB_FALLBACK=True
FALLBACK_DATABASE_URL="sqlite:///./careerbridge_test.db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# AI Mocking
GEMINI_API_KEY="test_mock_key"
AI_MOCK_FALLBACK=True

# Storage
STORAGE_DIR="./storage/test_resumes"

