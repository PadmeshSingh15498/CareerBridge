# Application Environment Configuration
PROJECT_NAME="CareerBridge"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# JWT Security
SECRET_KEY="generate_a_secure_random_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL 8 Database Configuration
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="careerbridge"
DATABASE_URL="mysql+pymysql://root:@localhost:3306/careerbridge"

# SQLite Fallback (used when MySQL server is not locally running)
ENABLE_DB_FALLBACK=True
FALLBACK_DATABASE_URL="sqlite:///./careerbridge.db"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI / LLM Configuration
GEMINI_API_KEY=""
AI_MOCK_FALLBACK=True

